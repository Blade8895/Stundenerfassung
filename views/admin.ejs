<%- include('partials/app-shell-top', { title: 'Administration', heading: 'Admin Control Center', subtitle: 'Benutzer, Projekte und Zuweisungen zentral verwalten.', active: 'admin' }) %>
<div class="grid three">
  <div class="card">
    <div class="card-head"><h2>Benutzer anlegen</h2></div>
    <form method="post" action="/admin/users" class="stack">
      <label>Name<input name="name" required /></label>
      <label>E-Mail<input type="email" name="email" required /></label>
      <label>Passwort<input type="password" name="password" required /></label>
      <label>Rolle
        <select name="role" required>
          <option value="employee">employee</option>
          <option value="trainee">trainee</option>
          <option value="admin">admin</option>
        </select>
      </label>
      <button type="submit">Speichern</button>
    </form>
  </div>

  <div class="card">
    <div class="card-head"><h2>Projekt anlegen</h2></div>
    <form method="post" action="/admin/projects" class="stack">
      <label>Name<input name="name" required /></label>
      <button type="submit">Projekt erstellen</button>
    </form>
  </div>

  <div class="card">
    <div class="card-head"><h2>Gesamtstunden</h2></div>
    <ul class="list">
      <% report.forEach((row) => { %>
        <li><span><%= row.user_name %></span><strong><%= row.total_hours %> h</strong></li>
      <% }) %>
    </ul>
  </div>
</div>

<div class="card">
  <div class="card-head"><h2>Zuweisungen</h2></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Benutzer</th><th>Rolle</th><th>Projekte</th></tr></thead>
      <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <td><%= u.name %><br><span class="muted"><%= u.email %></span></td>
          <td><%= u.role %></td>
          <td>
            <form method="post" action="/admin/assignments" class="stack inline-form">
              <input type="hidden" name="user_id" value="<%= u.id %>" />
              <select name="project_ids" multiple size="4">
                <% projects.forEach((p) => { const selected = assignmentMap.get(u.id) && assignmentMap.get(u.id).has(p.id); %>
                  <option value="<%= p.id %>" <%= selected ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
              </select>
              <button type="submit">Speichern</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/app-shell-bottom') %>
