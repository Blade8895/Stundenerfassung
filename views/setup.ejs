<%- include('partials/layout-top', { title }) %>
<div class="auth-shell">
  <form method="post" class="card auth-card stack">
    <h1>Initiales Setup</h1>
    <p class="muted">Lege den ersten Administrator fuer die Anwendung an.</p>
    <%- include('partials/flashes') %>
    <% if (error) { %><p class="inline-error"><%= error %></p><% } %>
    <label>Name
      <input type="text" name="name" required value="<%= form.name %>" />
    </label>
    <label>E-Mail
      <input type="email" name="email" required value="<%= form.email %>" />
    </label>
    <label>Passwort
      <input type="password" name="password" required minlength="8" />
    </label>
    <button type="submit">Admin anlegen</button>
  </form>
</div>
<%- include('partials/layout-bottom') %>
